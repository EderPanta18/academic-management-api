generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── IDENTIDAD ───────────────────────────────────────────────────────

model Person {
  id        Int       @id @default(autoincrement())
  dni       String    @unique @db.Char(8)
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  email     String    @unique @db.VarChar(150)
  phone     String?   @db.Char(9)
  birthDate DateTime? @map("birth_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  professor Professor?
  student   Student?

  @@map("person")
}

// ─── ESTRUCTURA ORGANIZACIONAL ───────────────────────────────────────

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  professors Professor[]
  careers    Career[]

  @@map("department")
}

model Career {
  id           Int       @id @default(autoincrement())
  departmentId Int       @map("department_id")
  name         String    @unique @db.VarChar(150)
  totalCredits Int       @map("total_credits") @db.SmallInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id])
  students   Student[]
  courses    Course[]

  @@map("career")
}

model AcademicPeriod {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(20)
  year      Int       @db.SmallInt
  semester  Int       @db.SmallInt
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  courseOfferings CourseOffering[]

  @@unique([year, semester])
  @@map("academic_period")
}

// ─── ACTORES ACADÉMICOS ──────────────────────────────────────────────

model Professor {
  personId           Int             @id @map("person_id")
  departmentId       Int?            @map("department_id")
  code               String          @unique @db.VarChar(20)
  specialty          String?         @db.VarChar(100)
  institutionalEmail String?         @unique @map("institutional_email") @db.VarChar(150)
  hireDate           DateTime?       @map("hire_date") @db.Date
  status             ProfessorStatus @default(ACTIVE)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")

  person          Person           @relation(fields: [personId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  courseOfferings CourseOffering[]

  @@map("professor")
}

enum ProfessorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Student {
  personId           Int           @id @map("person_id")
  careerId           Int           @map("career_id")
  code               String        @unique @db.Char(10)
  institutionalEmail String?       @unique @map("institutional_email") @db.VarChar(150)
  enrollmentDate     DateTime      @map("enrollment_date") @db.Date
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  person      Person       @relation(fields: [personId], references: [id])
  career      Career       @relation(fields: [careerId], references: [id])
  enrollments Enrollment[]

  @@map("student")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

// ─── CATÁLOGO ACADÉMICO ──────────────────────────────────────────────

model CourseCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  courses Course[]

  @@map("course_category")
}

// ─── GESTIÓN DE CURSOS ───────────────────────────────────────────────

model Course {
  id          Int       @id @default(autoincrement())
  careerId    Int       @map("career_id")
  categoryId  Int?      @map("category_id")
  name        String    @db.VarChar(150)
  description String?   @db.Text
  credits     Int       @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  career          Career          @relation(fields: [careerId], references: [id])
  category        CourseCategory? @relation(fields: [categoryId], references: [id])
  courseOfferings CourseOffering[]

  @@unique([careerId, name])
  @@map("course")
}

model CourseOffering {
  id                 Int                  @id @default(autoincrement())
  courseId           Int                  @map("course_id")
  academicPeriodId   Int                  @map("academic_period_id")
  professorId        Int?                 @map("professor_id")
  section            String               @default("A") @db.VarChar(10)
  maxStudents        Int                  @default(30) @map("max_students") @db.SmallInt
  enrollmentDeadline DateTime?            @map("enrollment_deadline") @db.Date
  status             CourseOfferingStatus @default(INACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")

  course         Course         @relation(fields: [courseId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  professor      Professor?     @relation(fields: [professorId], references: [personId])
  enrollments    Enrollment[]

  @@unique([courseId, academicPeriodId, section])
  @@map("course_offering")
}

enum CourseOfferingStatus {
  INACTIVE
  ACTIVE
  CANCELLED
  COMPLETED
}

// ─── INSCRIPCIONES ───────────────────────────────────────────────────

model Enrollment {
  id               Int              @id @default(autoincrement())
  studentId        Int              @map("student_id")
  courseOfferingId Int              @map("course_offering_id")
  status           EnrollmentStatus @default(ENROLLED)
  enrollmentDate   DateTime         @map("enrollment_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")
  createdBy        Int?             @map("created_by")

  student        Student              @relation(fields: [studentId], references: [personId])
  courseOffering CourseOffering       @relation(fields: [courseOfferingId], references: [id])
  statusLogs     EnrollmentStatusLog[]

  @@unique([studentId, courseOfferingId])
  @@map("enrollment")
}

enum EnrollmentStatus {
  ENROLLED
  WITHDRAWN
  COMPLETED
  SUSPENDED
}

model EnrollmentStatusLog {
  id             Int               @id @default(autoincrement())
  enrollmentId   Int               @map("enrollment_id")
  previousStatus EnrollmentStatus? @map("previous_status")
  newStatus      EnrollmentStatus  @map("new_status")
  reason         String?           @db.Text
  changedBy      Int?              @map("changed_by")
  createdAt      DateTime          @default(now()) @map("created_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("enrollment_status_log")
}