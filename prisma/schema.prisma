generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

enum ProfessorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AcademicPeriodStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum CourseOfferingStatus {
  DRAFT
  OPEN
  CLOSED
  FINISHED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  CANCELLED
  WITHDRAWN
}

enum EnrollmentMovementType {
  CREATED
  CANCELLED
  WITHDRAWN
  SECTION_CHANGED
  CORRECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum StudentImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum StudentImportResultStatus {
  ACCEPTED
  DUPLICATE
  REJECTED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
}

model DocumentType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text

  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  persons                      Person[]

  @@map("document_types")
}

model Person {
  id             String    @id @default(uuid()) @db.Uuid
  documentTypeId String    @db.Uuid
  documentNumber String    @db.VarChar(50)
  firstName      String    @db.VarChar(100)
  lastName       String    @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  birthDate      DateTime? @db.Date

  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  student             Student?
  professor           Professor?
  user                User?

  // Identidad documental global e inmutable, incluso tras la baja logica.
  @@unique([documentTypeId, documentNumber])
  @@index([documentNumber])
  @@index([deletedAt])
  @@map("persons")
}


model Faculty {
  id          String    @id @default(uuid()) @db.Uuid
  acronym     String    @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.Text

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  academicDepartments AcademicDepartment[]
  academicPrograms    AcademicProgram[]
  professors          Professor[]

  @@index([deletedAt])
  @@map("faculties")
}

model AcademicDepartment {
  id          String    @id @default(uuid()) @db.Uuid
  facultyId   String    @db.Uuid
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.Text

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  faculty Faculty  @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  courses Course[]

  @@index([facultyId])
  @@index([deletedAt])
  @@map("academic_departments")
}

model AcademicProgram {
  id          String    @id @default(uuid()) @db.Uuid
  facultyId   String    @db.Uuid
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.Text

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  faculty              Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  students             Student[]
  courseAssociations   AcademicProgramCourse[]
  enrollmentReferences Enrollment[]

  @@index([facultyId])
  @@index([deletedAt])
  @@map("academic_programs")
}

model AcademicProgramCourse {
  id                String    @id @default(uuid()) @db.Uuid
  academicProgramId String    @db.Uuid
  courseId          String    @db.Uuid
  validFrom         DateTime  @db.Timestamptz(6)
  validUntil        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  academicProgram AcademicProgram @relation(fields: [academicProgramId], references: [id], onDelete: Restrict)
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)

  // La exclusión de intervalos solapados se impone en una migración SQL de PostgreSQL.
  @@index([academicProgramId, courseId, validFrom])
  @@index([courseId])
  @@map("academic_program_courses")
}

model Student {
  id                 String        @id @default(uuid()) @db.Uuid
  personId           String        @unique @db.Uuid
  academicProgramId  String        @db.Uuid
  code               String        @db.VarChar(50)
  institutionalEmail String?       @db.VarChar(255)
  admissionPeriod    String?       @db.VarChar(50)
  status             StudentStatus @default(ACTIVE)

  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?     @db.Timestamptz(6)

  person          Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  academicProgram AcademicProgram       @relation(fields: [academicProgramId], references: [id], onDelete: Restrict)
  enrollments     Enrollment[]
  importResults   StudentImportResult[]

  @@index([academicProgramId])
  @@index([status])
  @@index([deletedAt])
  @@map("students")
}

model Professor {
  id                 String          @id @default(uuid()) @db.Uuid
  personId           String          @unique @db.Uuid
  facultyId          String          @db.Uuid
  code               String          @db.VarChar(50)
  institutionalEmail String?         @db.VarChar(255)
  specialty          String?         @db.VarChar(100)
  status             ProfessorStatus @default(ACTIVE)

  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?       @db.Timestamptz(6)

  person          Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  faculty         Faculty          @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  courseOfferings CourseOffering[]

  @@index([facultyId])
  @@index([status])
  @@index([deletedAt])
  @@map("professors")
}

model CourseCategory {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.Text

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  courses Course[]

  @@map("course_categories")
}

model Course {
  id                   String    @id @default(uuid()) @db.Uuid
  academicDepartmentId String    @db.Uuid
  courseCategoryId     String    @db.Uuid
  code                 String    @db.VarChar(50)
  name                 String    @db.VarChar(150)
  description          String?   @db.Text
  credits              Int
  hours                Int?

  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime? @db.Timestamptz(6)

  academicDepartment  AcademicDepartment      @relation(fields: [academicDepartmentId], references: [id], onDelete: Restrict)
  courseCategory      CourseCategory          @relation(fields: [courseCategoryId], references: [id], onDelete: Restrict)
  academicPrograms    AcademicProgramCourse[]
  courseOfferings     CourseOffering[]

  @@index([academicDepartmentId])
  @@index([courseCategoryId])
  @@index([deletedAt])
  @@map("courses")
}

model AcademicPeriod {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @db.VarChar(50)
  name                String               @db.VarChar(150)
  startDate           DateTime             @db.Date
  endDate             DateTime             @db.Date
  enrollmentStartDate DateTime             @db.Date
  enrollmentEndDate   DateTime             @db.Date
  status              AcademicPeriodStatus @default(PLANNED)

  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?            @db.Timestamptz(6)

  courseOfferings CourseOffering[]

  @@index([status])
  @@index([deletedAt])
  @@map("academic_periods")
}

model CourseOffering {
  id               String               @id @default(uuid()) @db.Uuid
  courseId         String               @db.Uuid
  academicPeriodId String               @db.Uuid
  professorId      String?              @db.Uuid
  section          String               @db.VarChar(20)
  maxCapacity      Int
  status           CourseOfferingStatus @default(DRAFT)

  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?            @db.Timestamptz(6)

  course         Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  professor      Professor?     @relation(fields: [professorId], references: [id], onDelete: Restrict)
  enrollments       Enrollment[]
  previousMovements EnrollmentMovement[] @relation("MovementPreviousOffering")
  newMovements      EnrollmentMovement[] @relation("MovementNewOffering")

  @@index([academicPeriodId])
  @@index([professorId])
  @@index([status])
  @@index([deletedAt])
  @@map("course_offerings")
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @db.Uuid
  courseOfferingId   String           @db.Uuid
  academicProgramId  String           @db.Uuid
  status             EnrollmentStatus
  enrolledAt         DateTime         @default(now()) @db.Timestamptz(6)
  registeredByUserId String           @db.Uuid

  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  student          Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  courseOffering   CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  academicProgram  AcademicProgram    @relation(fields: [academicProgramId], references: [id], onDelete: Restrict)
  registeredByUser User               @relation("RegisteredEnrollments", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  movements        EnrollmentMovement[] @relation("EnrollmentHistory")

  // La unicidad ENROLLED por estudiante+curso+periodo cruza la oferta:
  // se protege en la unidad SERIALIZABLE que utilizan todos los escritores autorizados.
  @@index([studentId, status])
  @@index([courseOfferingId, status])
  @@index([academicProgramId])
  @@index([registeredByUserId])
  @@map("enrollments")
}

model EnrollmentMovement {
  id                         String                 @id @default(uuid()) @db.Uuid
  enrollmentId               String                 @db.Uuid
  movementType               EnrollmentMovementType
  previousStatus             EnrollmentStatus?
  newStatus                  EnrollmentStatus?
  previousCourseOfferingId   String?                @db.Uuid
  newCourseOfferingId        String?                @db.Uuid
  correctionOfMovementId     String?                @unique @db.Uuid
  reason                     String?                @db.Text
  performedByUserId          String                 @db.Uuid

  createdAt                  DateTime               @default(now()) @db.Timestamptz(6)

  enrollment            Enrollment          @relation("EnrollmentHistory", fields: [enrollmentId], references: [id], onDelete: Restrict)
  previousCourseOffering CourseOffering?    @relation("MovementPreviousOffering", fields: [previousCourseOfferingId], references: [id], onDelete: Restrict)
  newCourseOffering      CourseOffering?    @relation("MovementNewOffering", fields: [newCourseOfferingId], references: [id], onDelete: Restrict)
  performedByUser        User               @relation("EnrollmentMovementsPerformed", fields: [performedByUserId], references: [id], onDelete: Restrict)
  correctionOf           EnrollmentMovement? @relation("MovementCorrections", fields: [correctionOfMovementId], references: [id], onDelete: Restrict)
  correctedBy            EnrollmentMovement? @relation("MovementCorrections")

  @@index([enrollmentId, createdAt])
  @@index([performedByUserId])
  @@map("enrollment_movements")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  personId             String?    @unique @db.Uuid
  email                String     @db.VarChar(255)
  passwordHash         String     @db.Text
  mustChangePassword   Boolean    @default(false)
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?  @db.Timestamptz(6)

  createdAt            DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?  @db.Timestamptz(6)

  person                  Person?              @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions                UserSession[]
  userRoles               UserRole[]           @relation("UserMemberships")
  registeredEnrollments   Enrollment[]         @relation("RegisteredEnrollments")
  enrollmentMovements     EnrollmentMovement[] @relation("EnrollmentMovementsPerformed")
  createdStudentImports   StudentImport[]      @relation("CreatedStudentImports")
  assignedUserRoles       UserRole[]           @relation("AssignedUserRoles")
  assignedRolePermissions RolePermission[]     @relation("AssignedRolePermissions")
  auditLogs               AuditLog[]           @relation("ActorAuditLogs")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @db.VarChar(100)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @db.VarChar(150)
  name        String    @db.VarChar(150)
  description String?   @db.Text
  module      String    @db.VarChar(100)
  isReserved  Boolean   @default(false)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId           String   @db.Uuid
  roleId           String   @db.Uuid
  assignedByUserId String?  @db.Uuid
  assignedAt       DateTime @default(now()) @db.Timestamptz(6)

  user           User  @relation("UserMemberships", fields: [userId], references: [id], onDelete: Restrict)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedByUser User? @relation("AssignedUserRoles", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId           String   @db.Uuid
  permissionId     String   @db.Uuid
  assignedByUserId String?  @db.Uuid
  assignedAt       DateTime @default(now()) @db.Timestamptz(6)

  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  assignedByUser User?      @relation("AssignedRolePermissions", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  refreshTokenHash String        @db.Text
  accessTokenJti   String?       @unique @db.VarChar(255)
  deviceName       String?       @db.VarChar(255)
  ipAddress        String?       @db.VarChar(64)
  userAgent        String?       @db.Text
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime      @db.Timestamptz(6)
  revokedAt        DateTime?     @db.Timestamptz(6)
  lastUsedAt       DateTime?     @db.Timestamptz(6)

  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Solo una sesion ACTIVE por usuario; se garantiza mediante SQL.
  @@index([userId, status])
  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(100)
  resourceId   String?  @db.VarChar(100)
  module       String?  @db.VarChar(100)
  description  String?  @db.Text
  metadata     Json?    @db.JsonB
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  actorUser User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model StudentImport {
  id              String              @id @default(uuid()) @db.Uuid
  fileName        String              @db.VarChar(255)
  fileExtension   String              @db.VarChar(10)
  fileHash        String              @db.VarChar(64)
  fileContent     Bytes               @db.ByteA
  fileMimeType    String?             @db.VarChar(150)
  status          StudentImportStatus @default(PENDING)
  totalRows       Int?
  failureReason   String?             @db.Text
  createdByUserId String              @db.Uuid
  startedAt       DateTime?           @db.Timestamptz(6)
  finishedAt      DateTime?           @db.Timestamptz(6)

  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  createdByUser User                  @relation("CreatedStudentImports", fields: [createdByUserId], references: [id], onDelete: Restrict)
  results       StudentImportResult[]

  @@unique([createdByUserId, fileHash])
  @@index([status, createdAt])
  @@map("student_imports")
}

model StudentImportResult {
  studentImportId String                    @db.Uuid
  rowNumber       Int
  status          StudentImportResultStatus
  studentId       String?                   @db.Uuid
  errorDetails    Json?                     @db.JsonB
  processedAt     DateTime                  @default(now()) @db.Timestamptz(6)

  studentImport StudentImport @relation(fields: [studentImportId], references: [id], onDelete: Restrict)
  student       Student?      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([studentImportId, rowNumber])
  @@index([studentId])
  @@map("student_import_results")
}

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  messageKey    String       @unique @db.VarChar(150)
  eventName     String       @db.VarChar(150)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  nextAttemptAt DateTime?    @db.Timestamptz(6)
  publishedAt   DateTime?    @db.Timestamptz(6)
  lastError     String?      @db.Text

  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}
