generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"    
  moduleFormat = "cjs"                  
}

datasource db {
  provider = "mysql"
}

// ─── SOPORTE (seed) ──────────────────────────────────────────────────

model Career {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  students  Student[]
  courses   Course[]

  @@map("career")
}

model Department {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  professors Professor[]

  @@map("department")
}

model AcademicPeriod {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(50)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  courseOfferings CourseOffering[]

  @@map("academic_period")
}

// ─── IDENTIDAD ───────────────────────────────────────────────────────

model Person {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  dni       String    @unique @db.Char(8)
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  email     String    @unique @db.VarChar(150)
  phone     String?   @db.VarChar(12)
  birthDate DateTime? @map("birth_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  professor Professor?
  student   Student?

  @@map("person")
}

// ─── PROFESORES ──────────────────────────────────────────────────────

model Professor {
  personId     Int             @id @map("person_id") @db.UnsignedInt
  departmentId Int?            @map("department_id") @db.UnsignedInt
  specialty    String?         @db.VarChar(100)
  hireDate     DateTime?       @map("hire_date") @db.Date
  status       ProfessorStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  person          Person           @relation(fields: [personId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  courseOfferings CourseOffering[]

  @@map("professor")
}

enum ProfessorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// ─── ALUMNOS ─────────────────────────────────────────────────────────

model Student {
  personId  Int       @id @map("person_id") @db.UnsignedInt
  code      String    @unique @db.Char(10)
  careerId  Int       @map("career_id") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  person      Person       @relation(fields: [personId], references: [id])
  career      Career       @relation(fields: [careerId], references: [id])
  enrollments Enrollment[]

  @@map("student")
}

// ─── CURSOS ──────────────────────────────────────────────────────────

model Course {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  name        String    @db.VarChar(150)
  description String?   @db.Text
  careerId    Int       @map("career_id") @db.UnsignedInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  career          Career           @relation(fields: [careerId], references: [id])
  courseOfferings CourseOffering[]

  @@map("course")
}

model CourseOffering {
  id               Int                  @id @default(autoincrement()) @db.UnsignedInt
  courseId         Int                  @map("course_id") @db.UnsignedInt
  academicPeriodId Int                  @map("academic_period_id") @db.UnsignedInt
  professorId      Int?                 @map("professor_id") @db.UnsignedInt
  maxStudents      Int                  @default(30) @map("max_students") @db.SmallInt
  status           CourseOfferingStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  course         Course         @relation(fields: [courseId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  professor      Professor?     @relation(fields: [professorId], references: [personId])
  enrollments    Enrollment[]

  @@map("course_offering")
}

enum CourseOfferingStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  COMPLETED
}

// ─── INSCRIPCIONES ───────────────────────────────────────────────────

model Enrollment {
  id               Int              @id @default(autoincrement()) @db.UnsignedInt
  studentId        Int              @map("student_id") @db.UnsignedInt
  courseOfferingId Int              @map("course_offering_id") @db.UnsignedInt
  enrollmentDate   DateTime         @default(now()) @map("enrollment_date") @db.DateTime(0)
  status           EnrollmentStatus @default(ENROLLED)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  student        Student        @relation(fields: [studentId], references: [personId])
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id])

  @@unique([studentId, courseOfferingId])
  @@map("enrollment")
}

enum EnrollmentStatus {
  ENROLLED
  WITHDRAWN
  COMPLETED
  SUSPENDED
}
