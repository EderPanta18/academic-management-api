{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",

    // aliases
    "paths": {
      "@app": ["./src/app/index.ts"],
      "@app/*": ["./src/app/*"],

      "@core": ["./src/core/index.ts"],
      "@core/*": ["./src/core/*"],

      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"],

      "@platform": ["./src/platform/index.ts"],
      "@platform/*": ["./src/platform/*"],

      "@modules": ["./src/modules/index.ts"],
      "@modules/*": ["./src/modules/*"],

      "@persons": ["./src/modules/persons/index.ts"],
      "@persons/*": ["./src/modules/persons/*"],

      "@departments": ["./src/modules/departments/index.ts"],
      "@departments/*": ["./src/modules/departments/*"],

      "@careers": ["./src/modules/careers/index.ts"],
      "@careers/*": ["./src/modules/careers/*"],

      "@academic-periods": ["./src/modules/academic-periods/index.ts"],
      "@academic-periods/*": ["./src/modules/academic-periods/*"],

      "@course-categories": ["./src/modules/course-categories/index.ts"],
      "@course-categories/*": ["./src/modules/course-categories/*"],

      "@courses": ["./src/modules/courses/index.ts"],
      "@courses/*": ["./src/modules/courses/*"],

      "@professors": ["./src/modules/professors/index.ts"],
      "@professors/*": ["./src/modules/professors/*"],

      "@students": ["./src/modules/students/index.ts"],
      "@students/*": ["./src/modules/students/*"],

      "@course-offerings": ["./src/modules/course-offerings/index.ts"],
      "@course-offerings/*": ["./src/modules/course-offerings/*"],

      "@enrollments": ["./src/modules/enrollments/index.ts"],
      "@enrollments/*": ["./src/modules/enrollments/*"]
    },

    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
