{
  "compilerOptions": {
    "module": "commonjs",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",

    // aliases
    "paths": {
      "@app": ["./src/app"],
      "@app/*": ["./src/app/*"],

      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],

      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],

      "@platform": ["./src/platform"],
      "@platform/*": ["./src/platform/*"],

      "@modules": ["./src/modules"],
      "@modules/*": ["./src/modules/*"],

      "@persons": ["./src/modules/persons"],
      "@persons/*": ["./src/modules/persons/*"],

      "@departments": ["./src/modules/departments"],
      "@departments/*": ["./src/modules/departments/*"],

      "@careers": ["./src/modules/careers"],
      "@careers/*": ["./src/modules/careers/*"],

      "@academic-periods": ["./src/modules/academic-periods"],
      "@academic-periods/*": ["./src/modules/academic-periods/*"],

      "@course-categories": ["./src/modules/course-categories"],
      "@course-categories/*": ["./src/modules/course-categories/*"],

      "@courses": ["./src/modules/courses"],
      "@courses/*": ["./src/modules/courses/*"],

      "@professors": ["./src/modules/professors"],
      "@professors/*": ["./src/modules/professors/*"],

      "@students": ["./src/modules/students"],
      "@students/*": ["./src/modules/students/*"],

      "@course-offerings": ["./src/modules/course-offerings"],
      "@course-offerings/*": ["./src/modules/course-offerings/*"],

      "@enrollments": ["./src/modules/enrollments"],
      "@enrollments/*": ["./src/modules/enrollments/*"]
    },

    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
