{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2023",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "outDir": "./dist",

        "paths": {
            "@app": ["./src/app"],
            "@app/*": ["./src/app/*"],

            "@core": ["./src/core"],
            "@core/*": ["./src/core/*"],

            "@platform": ["./src/platform"],
            "@platform/*": ["./src/platform/*"],

            "@shared": ["./src/shared"],
            "@shared/*": ["./src/shared/*"],

            "@workers": ["./src/workers"],
            "@workers/*": ["./src/workers/*"],

            "@modules": ["./src/modules"],
            "@modules/*": ["./src/modules/*"],

            "@identity": ["./src/modules/identity"],
            "@identity/*": ["./src/modules/identity/*"],

            "@faculties": ["./src/modules/faculties"],
            "@faculties/*": ["./src/modules/faculties/*"],

            "@academic-departments": ["./src/modules/academic-departments"],
            "@academic-departments/*": ["./src/modules/academic-departments/*"],

            "@academic-programs": ["./src/modules/academic-programs"],
            "@academic-programs/*": ["./src/modules/academic-programs/*"],

            "@courses": ["./src/modules/courses"],
            "@courses/*": ["./src/modules/courses/*"],

            "@professors": ["./src/modules/professors"],
            "@professors/*": ["./src/modules/professors/*"],

            "@students": ["./src/modules/students"],
            "@students/*": ["./src/modules/students/*"],

            "@academic-periods": ["./src/modules/academic-periods"],
            "@academic-periods/*": ["./src/modules/academic-periods/*"],

            "@course-offerings": ["./src/modules/course-offerings"],
            "@course-offerings/*": ["./src/modules/course-offerings/*"],

            "@enrollments": ["./src/modules/enrollments"],
            "@enrollments/*": ["./src/modules/enrollments/*"],

            "@users": ["./src/modules/users"],
            "@users/*": ["./src/modules/users/*"],

            "@authorization": ["./src/modules/authorization"],
            "@authorization/*": ["./src/modules/authorization/*"],

            "@audit": ["./src/modules/audit"],
            "@audit/*": ["./src/modules/audit/*"],

            "@reports": ["./src/modules/reports"],
            "@reports/*": ["./src/modules/reports/*"],
        },

        "skipLibCheck": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,
        "strictBindCallApply": false,
        "noFallthroughCasesInSwitch": false,
    },
    "include": ["src/**/*", "prisma/**/*"],
}
