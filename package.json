{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "description": "API del asistente virtual académico",
  "author": "EdeRev",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start:prod": "bun dist/main.js",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "db:dev": "prisma migrate dev && prisma db seed",
    "db:prod": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
