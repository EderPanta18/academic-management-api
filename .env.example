# Copia este archivo a .env y completa los valores reales

# =========================================================
# General
# =========================================================
NODE_ENV=development

APP_PORT=3000
APP_NAME="Academic Backend API"
APP_DESCRIPTION="API for managing academic data"
APP_VERSION=1.0.0

API_PREFIX="/api/v1"

# =========================================================
# Log
# =========================================================
LOG_LEVEL=debug

# =========================================================
# Database
# =========================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_backend_dev"
DATABASE_LOG_QUERIES=false

# =========================================================
# JWT
# =========================================================
JWT_ACCESS_NAME="accessJwt"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_NAME="refreshJwt"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# =========================================================
# Auth
# =========================================================
AUTH_SINGLE_SESSION=true
AUTH_REFRESH_TOKEN_ROTATION=true

# =========================================================
# CORS
# =========================================================
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
CORS_CREDENTIALS=true

# =========================================================
# OpenAPI
# =========================================================
OPENAPI_ENABLED=true
OPENAPI_PATH="/docs"

# =========================================================
# Admin seed
# =========================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="System"

# =========================================================
# Upload
# =========================================================
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIME_TYPES="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"

# =========================================================
# Redis
# =========================================================
REDIS_URL="redis://localhost:6379"

# =========================================================
# Queue (BullMQ)
# =========================================================
QUEUE_EVENT_BUS_ATTEMPTS=1
QUEUE_EVENT_BUS_REMOVE_ON_COMPLETE=50
QUEUE_EVENT_BUS_REMOVE_ON_FAIL=200
QUEUE_EVENT_BUS_CONCURRENCY=5

QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY_MS=1000
QUEUE_JOB_REMOVE_ON_COMPLETE=100
QUEUE_JOB_REMOVE_ON_FAIL=1000
QUEUE_JOB_CONCURRENCY=5
