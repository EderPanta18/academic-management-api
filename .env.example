# Copia este archivo a .env y completa los valores reales

# =========================================================
# General
# =========================================================
NODE_ENV=development

APP_PORT=3000
APP_NAME="Academic Management API"
APP_DESCRIPTION="REST API for university academic administration and enrollment management"
APP_VERSION=1.0.0

API_PREFIX="/api/v1"

# =========================================================
# Log
# =========================================================
LOG_LEVEL=debug

# =========================================================
# Database
# =========================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_backend_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_backend_dev?schema=public"
DATABASE_LOG_QUERIES=false

# =========================================================
# Queue (PgBoss sobre PostgreSQL)
# =========================================================
QUEUE_SCHEMA="pgboss"

QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY_MS=1000
QUEUE_RETRY_BACKOFF=true
QUEUE_EXPIRE_IN_MINUTES=15
QUEUE_ARCHIVE_COMPLETED_AFTER_DAYS=7
QUEUE_ARCHIVE_FAILED_AFTER_DAYS=30

QUEUE_JOB_CONCURRENCY=5
QUEUE_EVENT_CONCURRENCY=5

# =========================================================
# JWT
# =========================================================
JWT_ACCESS_NAME="accessJwt"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_NAME="refreshJwt"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# =========================================================
# Auth
# =========================================================
AUTH_SINGLE_SESSION=true
AUTH_REFRESH_TOKEN_ROTATION=true

# =========================================================
# CORS
# =========================================================
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
CORS_CREDENTIALS=true

# =========================================================
# OpenAPI
# =========================================================
OPENAPI_ENABLED=true
OPENAPI_PATH="/docs"

# =========================================================
# Admin seed
# =========================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="System"
